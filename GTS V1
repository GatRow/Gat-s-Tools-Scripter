function VanillaPoseApplier:_ensureRigSearchCache(rig)
  if not rig or not self.posesByRig[rig] then
    return nil
  end

  local cache = self.rigSearchCache[rig]
  if cache then
    return cache
  end

  local list = self.posesByRig[rig] or {}
  local entries = {}
  local exactNameIndex = {}
  for i = 1, #list do
    local name = list[i]
    entries[i] = {
      index = i,
      name = name,
      normalizedName = normalizeQuery(name),
      normalizedPrettyName = normalizeQuery(prettifyName(name)),
    }
    exactNameIndex[name] = i
  end

  cache = {
    entries = entries,
    exactNameIndex = exactNameIndex,
  }
  self.rigSearchCache[rig] = cache
  return cache
end

function VanillaPoseApplier:FindPose(rig, exactName)
  if not rig or not exactName then
    return nil
  end

  local cache = self:_ensureRigSearchCache(rig)
  if not cache then
    return nil
  end

  local index = cache.exactNameIndex[exactName]
  if not index then
    return nil
  end

  return self:BuildPose(rig, exactName, index)
end

function VanillaPoseApplier:GetPosesForRig(rig)
  local cache = self:_ensureRigSearchCache(rig)
  if not cache then
    return {}
  end

  local out = {}
  for i = 1, #cache.entries do
    local entry = cache.entries[i]
    out[i] = self:BuildPose(rig, entry.name, entry.index)
  end

  return out
end

function VanillaPoseApplier:_cacheSearchResults(query, rig, limit, results)
  self.searchCache = {
    query = query,
    rig = rig,
    limit = tonumber(limit) or 0,
    results = type(results) == "table" and results or {},
  }
end

function VanillaPoseApplier:Search(query, rigFilter, limit)
  local needle = normalizeQuery(query)
  local maxResults = tonumber(limit) or 200
  if maxResults < 1 then
    maxResults = 1
  end

  local rigKey = (rigFilter and self.posesByRig[rigFilter]) and rigFilter or ""
  local cache = self.searchCache or {}
  if cache.query == needle and tostring(cache.rig or "") == rigKey and tonumber(cache.limit or 0) >= maxResults and type(cache.results) == "table" then
    local cachedOut = {}
    local cap = math.min(#cache.results, maxResults)
    for i = 1, cap do
      cachedOut[i] = cache.results[i]
    end
    return cachedOut
  end

  local rigs = {}
  if rigKey ~= "" then
    rigs[1] = rigKey
  else
    rigs = self.rigOrder
  end

  local results = {}
  for _, rig in ipairs(rigs) do
    local rigCache = self:_ensureRigSearchCache(rig)
    local entries = rigCache and rigCache.entries or {}
    for i = 1, #entries do
      local entry = entries[i]
      local hit = (needle == "")
        or entry.normalizedName:find(needle, 1, true)
        or entry.normalizedPrettyName:find(needle, 1, true)

      if hit then
        results[#results + 1] = self:BuildPose(rig, entry.name, entry.index)
        if #results >= maxResults then
          self:_cacheSearchResults(needle, rigKey, maxResults, results)
          return results
        end
      end
    end
  end

  self:_cacheSearchResults(needle, rigKey, maxResults, results)
  return results
end

