end

local function _drawSummaryColumn()
  local st    = RuleBuilder.state
  local draft = _normalizeRule(_clone(st.draftRule))
  local saved = _selectedSavedRule()
  local liveStatus = saved and RuleRunner.GetStatus(saved.id) or nil

  ImGui.BeginChild("macros_summary_column", 0, 0, true)

  -- ── Script identity & save status ────────────────────────────────────────
  _textColored(0.92, 0.82, 0.28, 1.0, "Script")
  ImGui.SameLine()
  ImGui.TextUnformatted(tostring(draft.name ~= "" and draft.name or "New Script"))

  if st.draftDirty then
    _textColored(1.00, 0.75, 0.20, 1.0, "● Unsaved")
  elseif saved then
    if liveStatus and liveStatus.lastEval then
      _textColored(0.35, 0.95, 0.45, 1.0, "● READY")
    else
      _textColored(1.00, 0.40, 0.40, 1.0, "● WAITING")
    end
  else
    ImGui.TextDisabled("Not saved yet")
  end

  if saved then
    if ImGui.SmallButton("Run Now##summary_run") then
      local _, msg = RuleRunner.RunRuleNow(saved.id)
      st.lastMessage = tostring(msg or "Ran.")
    end
    ImGui.SameLine()
    ImGui.TextDisabled("id: " .. tostring(saved.id or "?"))
  end

  -- ── Timing summary ────────────────────────────────────────────────────────
  ImGui.Separator()
  _textColored(0.92, 0.82, 0.28, 1.0, "Timing")
  ImGui.TextWrapped(_behaviorSummary(((draft.data or {}).execution) or {}, _ruleHasStatefulActions(draft)))

  -- ── Conditions summary ────────────────────────────────────────────────────
  ImGui.Separator()
  local conditions = ((draft.data or {}).conditions) or {}
  local modeLabel  = tostring((draft.data or {}).conditionMode or "ALL")
  _textColored(0.92, 0.82, 0.28, 1.0, "Conditions  (" .. modeLabel .. "  ·  " .. tostring(#conditions) .. ")")
  if #conditions == 0 then
    ImGui.TextDisabled("None — fires unconditionally")
  else
    -- Show live pass/fail from liveStatus if available, else static summary
    local results = (liveStatus and type(liveStatus.lastConditionResults) == "table")
      and liveStatus.lastConditionResults or {}
    local resultMap = {}
    for _, r in ipairs(results) do
      resultMap[tostring(r.label or "")] = r
    end
    for i = 1, #conditions do
      local cond  = conditions[i]
      local label = _conditionLabel(cond)
      local expectStr = cond.expected ~= false and "YES" or "NOT"
      local live = resultMap[tostring(label)]
      if live then
        local r, g, b, a = _debugPassColor(live)
        local symbol = (live.pass == true) and "✓" or "✗"
        _textColored(r, g, b, a, symbol .. " " .. label .. " = " .. expectStr)
      else
        ImGui.TextDisabled("• " .. label .. " = " .. expectStr)
      end
    end
  end

  -- ── Actions summary ───────────────────────────────────────────────────────
  ImGui.Separator()
  local groups = _groupsForRule(draft, "actionGroups")
  local totalActions = _countActionsInGroups(groups)
  _textColored(0.92, 0.82, 0.28, 1.0, "DO  (" .. tostring(totalActions) .. " action" .. (totalActions ~= 1 and "s" or "") .. ")")
  if totalActions == 0 then
    ImGui.TextDisabled("No actions yet")
  else
    for gi = 1, #groups do
      local group   = groups[gi] or {}
      local actions = group.actions or {}
      if #actions > 0 then
        local modeTag = tostring(group.mode or "ordered") == "parallel" and "[∥]" or "[→]"
        ImGui.TextDisabled(modeTag .. " " .. tostring(group.name or ("Group " .. tostring(gi))))
        for i = 1, #actions do
          ImGui.BulletText(_summaryActionLine(actions[i]))
        end
      end
    end
  end

  -- ── ON FALSE summary ──────────────────────────────────────────────────────
  local exec        = ((draft.data or {}).execution) or {}
  local falsePolicy = tostring(exec.falsePolicy or "do_nothing")
  if falsePolicy == "run_exit_actions" then
    ImGui.Separator()
    local fGroups = _groupsForRule(draft, "falseActionGroups")
    local fTotal  = _countActionsInGroups(fGroups)
    _textColored(0.92, 0.82, 0.28, 1.0, "ON FALSE  (" .. tostring(fTotal) .. ")")
    if fTotal == 0 then
      ImGui.TextDisabled("No exit actions")
    else
      for gi = 1, #fGroups do
        local group   = fGroups[gi] or {}
        local actions = group.actions or {}
        for i = 1, #actions do ImGui.BulletText(_summaryActionLine(actions[i])) end
      end
    end
  end

  -- ── Live blocked reason ───────────────────────────────────────────────────
  if liveStatus then
    local blocked = tostring(liveStatus.lastBlockedReason or "")
    if blocked ~= "" and liveStatus.lastEval ~= true then
      ImGui.Separator()
      _textColored(1.00, 0.55, 0.20, 1.0, "Blocked: " .. blocked)
    end
    local msg = tostring(liveStatus.lastMessage or "")
    if msg ~= "" then
      ImGui.TextDisabled(msg)
    end
  end

  ImGui.EndChild()
end

