-- Deduplicated flat label list for backwards-compat paths that need it.
local function _actionTypeChoices()
  local seen, out = {}, {}
  for _, entry in ipairs(_ACTION_GROUPS) do
    if not entry.header and entry.label and not seen[entry.id] then
      seen[entry.id] = true
      out[#out + 1] = entry.label
    end
  end
  return out
end

-- Grouped combo for action type selection. Returns the chosen action type id.
local function _actionTypeGroupedCombo(comboId, currentTypeId)
  local currentLabel = _actionTypeLabel(currentTypeId)
  local changed = false
  local chosenId = currentTypeId

  if ImGui.BeginCombo(comboId, currentLabel) then
    for _, entry in ipairs(_ACTION_GROUPS) do
      if entry.header then
        ImGui.TextDisabled(entry.header)
      else
        local selected = (entry.id == currentTypeId)
        if ImGui.Selectable("  " .. entry.label .. "##" .. comboId .. "_" .. entry.id, selected) then
          chosenId = entry.id
          changed = true
        end
        if selected then ImGui.SetItemDefaultFocus() end
      end
    end
    ImGui.EndCombo()
  end

  return chosenId, changed
end

