local function vpa_safePlayer()
  local ok, player = pcall(function()
    return Game.GetPlayer()
  end)
  if ok then
    return player
  end
  return nil
end

local function vpa_wrapTarget(handle, kind)
  if not handle then
    return nil
  end

  local record = makeTargetRecord(handle)
  record.kind = kind or "npc"
  record.rigKeys = vpa_detectTargetRigKeys(handle, record.kind == "player")
  record.allowedRigLabels = vpa_buildRigLabelsFromKeys(record.rigKeys)
  return record
end

local function vpa_tryGetTarget()
  local player = vpa_safePlayer()
  if not player then
    return nil, "player unavailable"
  end

  local targetingSystem = nil
  pcall(function()
    targetingSystem = Game.GetTargetingSystem()
  end)

  if not targetingSystem then
    return nil, "targeting system unavailable"
  end

  local attempts = {
    function() return targetingSystem:GetLookAtObject(player, false, false) end,
    function() return targetingSystem:GetLookAtObject(player, true, false) end,
    function() return targetingSystem:GetDefaultCrosshairTarget() end,
    function() return targetingSystem:GetCrosshairTarget() end,
  }

  for _, fn in ipairs(attempts) do
    local ok, value = pcall(fn)
    if ok and value then
      return vpa_wrapTarget(value, "npc"), nil
    end
  end

  return nil, "no target"
end

local function vpa_getAllowedRigLabelsForCurrentContext()
  if VanillaPoseApplierUI.applyToPlayer then
    local player = vpa_safePlayer()
    if not player then
      return copyArray(VPA_ALL_RIG_LABELS)
    end
    local wrapped = vpa_wrapTarget(player, "player")
    return (wrapped and wrapped.allowedRigLabels) or copyArray(VPA_ALL_RIG_LABELS)
  end

  local target = select(1, vpa_tryGetTarget())
  if target and target.allowedRigLabels and #target.allowedRigLabels > 0 then
    return target.allowedRigLabels
  end

  return copyArray(VPA_ALL_RIG_LABELS)
end

local function vpa_pickRandomPose(rig)
  local cache = VanillaPoseApplier:_ensureRigSearchCache(rig)
  local entries = cache and cache.entries or {}
  if #entries == 0 then
    return nil
  end
  local index = math.random(1, #entries)
  local entry = entries[index]
  if not entry then
    return nil
  end
  return VanillaPoseApplier:BuildPose(rig, entry.name, entry.index)
end

local function vpa_describePoseSelection(poseName, rig)
  local cleanPose = vpa_trimString(poseName or "")
  if cleanPose == "" then
    cleanPose = "(choose animation)"
  end
  local cleanRig = vpa_trimString(rig or "")
  if cleanRig ~= "" then
    return cleanPose .. " | " .. cleanRig
  end
  return cleanPose
end

local function vpa_refreshVisible()
  local allowedRigLabels = vpa_getAllowedRigLabelsForCurrentContext()
  local rig = VanillaPoseApplierUI.selectedRig
  VanillaPoseApplierUI.maxResults = vpa_getPoseSearchLimit(VanillaPoseApplierUI.maxResults)
  local limit = VanillaPoseApplierUI.maxResults

  if #allowedRigLabels > 0 and not vpa_containsString(allowedRigLabels, rig) then
    VanillaPoseApplierUI.selectedRig = allowedRigLabels[1]
    rig = VanillaPoseApplierUI.selectedRig
  end

  vpa_setLastRig(rig)
  VanillaPoseApplierUI.visible = VanillaPoseApplier:Search(VanillaPoseApplierUI.search, rig, limit)

  if #VanillaPoseApplierUI.visible == 0 then
    VanillaPoseApplierUI.selectedIndex = 0
    VanillaPoseApplierUI.selectedName = nil
    return
  end

  if VanillaPoseApplierUI.selectedIndex < 1 or VanillaPoseApplierUI.selectedIndex > #VanillaPoseApplierUI.visible then
    VanillaPoseApplierUI.selectedIndex = 1
  end

  local current = VanillaPoseApplierUI.visible[VanillaPoseApplierUI.selectedIndex]
  VanillaPoseApplierUI.selectedName = current and current.name or nil
end

local function vpa_setStatus(msg)
  VanillaPoseApplierUI.status = tostring(msg or "")
end

local function vpa_resolveApplyTarget()
  if VanillaPoseApplierUI.applyToPlayer then
    local player = vpa_safePlayer()
    if not player then
      return nil, "player unavailable"
    end
    return vpa_wrapTarget(player, "player"), nil
  end

  return vpa_tryGetTarget()
end

local function vpa_buildControlOptions()
  return {
    freezeAfterSeconds = parsePositiveNumber(VanillaPoseApplierUI.freezeAfterText),
    stopAfterSeconds = parsePositiveNumber(VanillaPoseApplierUI.stopAfterText),
  }
end

local VPA_SEQUENCE_ACTIONS = { "None", "Freeze", "Stop" }
local VPA_SEQUENCE_STATE = {
  active = nil,
}

local function vpa_presetsNormalizeSelection()
  local count = #VanillaPoseApplierUI.presets
  if count <= 0 then
    VanillaPoseApplierUI.presetSelectedIndex = 0
    return
  end
  if VanillaPoseApplierUI.presetSelectedIndex < 1 then
    VanillaPoseApplierUI.presetSelectedIndex = 1
  elseif VanillaPoseApplierUI.presetSelectedIndex > count then
    VanillaPoseApplierUI.presetSelectedIndex = count
  end
end

local function vpa_presetsClonePresetSteps(steps)
  local out = {}
  for i, step in ipairs(steps or {}) do
    local rig = vpa_trimString(step.rig)
    local name = vpa_trimString(step.name)
    out[i] = {
      rig = rig,
      name = name,
      displayName = vpa_trimString(step.displayName) ~= "" and tostring(step.displayName) or prettifyName(name),
      secondsText = tostring(step.secondsText or step.seconds or "3.0"),
      seconds = tonumber(step.seconds) or parsePositiveNumber(step.secondsText) or 3.0,
      endAction = vpa_trimString(step.endAction) ~= "" and vpa_trimString(step.endAction) or "None",
    }
  end
  return out
end

local function vpa_presetsAssetToPreset(asset)
  if type(asset) ~= "table" then return nil end
  local data = type(asset.data) == "table" and asset.data or {}
  return {
    id = tostring(asset.id or ""),
    name = tostring(asset.name or asset.id or "Unnamed sequence"),
    steps = vpa_presetsClonePresetSteps(data.steps or {}),
  }
end

local function vpa_presetsFindIndexByName(name)
  local wanted = tostring(name or "")
  for i, preset in ipairs(VanillaPoseApplierUI.presets) do
    if tostring(preset.name or "") == wanted then
      return i
    end
  end
  return 0
end

local function vpa_presetsLoadAll()
  local assets = (AssetRegistry and AssetRegistry.List and AssetRegistry.List("animation_sequence")) or {}
  local presets = {}
  for _, asset in ipairs(assets) do
    local preset = vpa_presetsAssetToPreset(asset)
    if preset then presets[#presets + 1] = preset end
  end
  table.sort(presets, function(a, b)
    return tostring(a.name or ""):lower() < tostring(b.name or ""):lower()
  end)
  VanillaPoseApplierUI.presets = presets
  vpa_presetsNormalizeSelection()
  if #presets > 0 then
    VanillaPoseApplierUI.presetStatus = string.format("Loaded %d saved sequence(s).", #presets)
  else
    VanillaPoseApplierUI.presetStatus = "No saved sequences yet."
  end
  return true
end

local function vpa_presetsEnsureLoaded()
  return vpa_presetsLoadAll()
end

local function vpa_presetsCaptureCurrent(name)
  local cleanName = vpa_trimString(name)
  if cleanName == "" then
    return false, "enter a sequence name first"
  end
  if #VanillaPoseApplierUI.sequenceSteps <= 0 then
    return false, "no sequence steps to save"
  end

  local asset = (AssetRegistry.MakeEmptyAnimationSequence and AssetRegistry.MakeEmptyAnimationSequence()) or { type = "animation_sequence", data = {} }
  asset.type = "animation_sequence"
  asset.name = cleanName
  asset.data = type(asset.data) == "table" and asset.data or {}
  asset.data.steps = vpa_presetsClonePresetSteps(VanillaPoseApplierUI.sequenceSteps)

  local saved, err = ((AssetRegistry.UpsertNew and AssetRegistry.UpsertNew(asset, cleanName)) or (AssetRegistry.Upsert and AssetRegistry.Upsert(asset)))
  if not saved then
    VanillaPoseApplierUI.presetStatus = "Save failed: " .. tostring(err or "unknown error")
    return false, err or "save failed"
  end

  vpa_presetsLoadAll()
  VanillaPoseApplierUI.presetSelectedIndex = vpa_presetsFindIndexByName(tostring(saved.name or cleanName))
  VanillaPoseApplierUI.presetName = tostring(saved.name or cleanName)
  VanillaPoseApplierUI.presetStatus = "Saved sequence: " .. tostring(saved.name or cleanName)
  return true
end

local function vpa_presetsGetSelected()
  local i = VanillaPoseApplierUI.presetSelectedIndex
  if not i or i < 1 or i > #VanillaPoseApplierUI.presets then
    return nil, 0
  end
  return VanillaPoseApplierUI.presets[i], i
end

local function vpa_presetsLoadIntoSequence(append)
  local preset = select(1, vpa_presetsGetSelected())
  if not preset then
    return false, "select a saved sequence first"
  end

  local steps = vpa_presetsClonePresetSteps(preset.steps or {})
  if append then
    for _, step in ipairs(steps) do
      VanillaPoseApplierUI.sequenceSteps[#VanillaPoseApplierUI.sequenceSteps + 1] = step
    end
    VanillaPoseApplierUI.sequenceStatus = "Appended sequence: " .. tostring(preset.name)
  else
    VanillaPoseApplierUI.sequenceSteps = steps
    VanillaPoseApplierUI.sequenceStatus = "Loaded sequence: " .. tostring(preset.name)
  end

  VanillaPoseApplierUI.sequenceSelectedIndex = #VanillaPoseApplierUI.sequenceSteps > 0 and 1 or 0
  VanillaPoseApplierUI.sequenceRunning = false
  VPA_SEQUENCE_STATE.active = nil
  VanillaPoseApplierUI.presetName = tostring(preset.name or "")
  return true
end

local function vpa_presetsDeleteSelected()
  local preset, index = vpa_presetsGetSelected()
  if not preset then
    return false, "select a saved sequence first"
  end
  if not AssetRegistry.Delete or not preset.id or preset.id == "" then
    return false, "missing saved sequence id"
  end
  AssetRegistry.Delete(preset.id)
  vpa_presetsLoadAll()
  VanillaPoseApplierUI.presetStatus = "Deleted sequence: " .. tostring(preset.name or "")
  return true
end

local function vpa_sequenceActionIndex(action)
  local current = tostring(action or "None")
  for i, value in ipairs(VPA_SEQUENCE_ACTIONS) do
    if value == current then
      return i
    end
  end
  return 1
end

local function vpa_findPoseFromStep(step)
  if not step then
    return nil
  end

  local rig = vpa_trimString(step.rig)
  local name = vpa_trimString(step.name)
  if name == "" then
    return nil
  end

  if rig ~= "" then
    local pose = VanillaPoseApplier:FindPose(rig, name)
    if pose then
      return pose
    end
  end

  for _, candidateRig in ipairs(VanillaPoseApplier:GetRigOrder()) do
    local pose = VanillaPoseApplier:FindPose(candidateRig, name)
    if pose then
      return pose
    end
  end

  local wantedLower = name:lower()
  for _, candidateRig in ipairs(VanillaPoseApplier:GetRigOrder()) do
    local list = VanillaPoseApplier.posesByRig[candidateRig] or {}
    for i = 1, #list do
      if tostring(list[i] or ""):lower() == wantedLower then
        return VanillaPoseApplier:BuildPose(candidateRig, list[i], i)
      end
    end
  end

  return nil
end

local function vpa_sequenceBuildStep(pose)
  if not pose then
    return nil
  end

  local seconds = parsePositiveNumber(VanillaPoseApplierUI.sequenceDefaultSeconds) or 3.0
  return {
    rig = pose.rig,
    name = pose.name,
    displayName = pose.displayName or prettifyName(pose.name),
    secondsText = tostring(seconds),
    seconds = seconds,
    endAction = tostring(VanillaPoseApplierUI.sequenceDefaultAction or "None"),
  }
end

local function vpa_sequenceCloneSteps(steps)
  local out = {}
  for i, step in ipairs(steps or {}) do
    out[i] = {
      rig = step.rig,
      name = step.name,
      displayName = step.displayName,
      secondsText = tostring(step.secondsText or step.seconds or "3.0"),
      seconds = tonumber(step.seconds) or parsePositiveNumber(step.secondsText) or 3.0,
      endAction = tostring(step.endAction or "None"),
    }
  end
  return out
end

local function vpa_sequenceGetSelectedStep()
  local i = VanillaPoseApplierUI.sequenceSelectedIndex
  if not i or i < 1 or i > #VanillaPoseApplierUI.sequenceSteps then
    return nil, 0
  end
  return VanillaPoseApplierUI.sequenceSteps[i], i
end

local function vpa_sequenceNormalizeSelection()
  local count = #VanillaPoseApplierUI.sequenceSteps
  if count <= 0 then
    VanillaPoseApplierUI.sequenceSelectedIndex = 0
    return
  end
  if VanillaPoseApplierUI.sequenceSelectedIndex < 1 then
    VanillaPoseApplierUI.sequenceSelectedIndex = 1
  elseif VanillaPoseApplierUI.sequenceSelectedIndex > count then
    VanillaPoseApplierUI.sequenceSelectedIndex = count
  end
end

local function vpa_sequenceDescribeStep(step, index)
  local action = tostring(step.endAction or "None")
  local rig = vpa_trimString(step.rig)
  local name = vpa_trimString(step.displayName or step.name or "?")
  return string.format("%d. [%s] %s | %ss | %s", index, rig ~= "" and rig or "?", name, tostring(step.secondsText or step.seconds or "?"), action)
end

local function vpa_sequenceAddSelectedPose()
  local selected = VanillaPoseApplierUI.visible[VanillaPoseApplierUI.selectedIndex]
  if not selected then
    return false, "no selected pose"
  end
  local step = vpa_sequenceBuildStep(selected)
  if not step then
    return false, "could not build step"
  end
  VanillaPoseApplierUI.sequenceSteps[#VanillaPoseApplierUI.sequenceSteps + 1] = step
  VanillaPoseApplierUI.sequenceSelectedIndex = #VanillaPoseApplierUI.sequenceSteps
  VanillaPoseApplierUI.sequenceStatus = "Added step: " .. tostring(step.name)
  return true
end

local function vpa_sequenceRemoveSelected()
  local _, index = vpa_sequenceGetSelectedStep()
  if index < 1 then
    return false, "no selected step"
  end
  table.remove(VanillaPoseApplierUI.sequenceSteps, index)
  vpa_sequenceNormalizeSelection()
  VanillaPoseApplierUI.sequenceStatus = "Removed step"
  return true
end

local function vpa_sequenceMoveSelected(delta)
  local step, index = vpa_sequenceGetSelectedStep()
  if not step or index < 1 then
    return false, "no selected step"
  end
  local newIndex = index + (delta or 0)
  if newIndex < 1 or newIndex > #VanillaPoseApplierUI.sequenceSteps then
    return false, "step already at edge"
  end
  VanillaPoseApplierUI.sequenceSteps[index], VanillaPoseApplierUI.sequenceSteps[newIndex] = VanillaPoseApplierUI.sequenceSteps[newIndex], VanillaPoseApplierUI.sequenceSteps[index]
  VanillaPoseApplierUI.sequenceSelectedIndex = newIndex
  VanillaPoseApplierUI.sequenceStatus = "Moved step"
  return true
end

local function vpa_sequenceClear()
  VanillaPoseApplierUI.sequenceSteps = {}
  VanillaPoseApplierUI.sequenceSelectedIndex = 0
  VanillaPoseApplierUI.sequenceStatus = "Sequence cleared."
end

local function vpa_sequenceStopCurrent(stopPose)
  local seq = VPA_SEQUENCE_STATE.active
  if not seq then
    VanillaPoseApplierUI.sequenceRunning = false
    return false, "no active sequence"
  end

  if stopPose ~= false and seq.target then
    pcall(function()
      VanillaPoseApplier:Stop(seq.target, true)
    end)
  end

  VPA_SEQUENCE_STATE.active = nil
  VanillaPoseApplierUI.sequenceRunning = false
  VanillaPoseApplierUI.sequenceStatus = "Sequence stopped."
  return true
end

local function vpa_sequenceAdvance(seq, messagePrefix)
  if not seq then
    return false, "sequence missing"
  end

  seq.stepIndex = (tonumber(seq.stepIndex) or 0) + 1
  seq.stepElapsed = 0.0
  seq.waitForActive = true
  seq.waitElapsed = 0.0
  seq.transitionDelay = 0.0

  local step = seq.steps[seq.stepIndex]
  if not step then
    VPA_SEQUENCE_STATE.active = nil
    VanillaPoseApplierUI.sequenceRunning = false
    VanillaPoseApplierUI.sequenceStatus = (messagePrefix or "Sequence complete.")
    return true
  end

  if VanillaPoseApplier:IsFrozen(seq.target) then
    pcall(function()
      VanillaPoseApplier:SetFrozen(seq.target, false, false)
    end)
  end

  local pose = vpa_findPoseFromStep(step)
  if not pose then
    VPA_SEQUENCE_STATE.active = nil
    VanillaPoseApplierUI.sequenceRunning = false
    VanillaPoseApplierUI.sequenceStatus = "Sequence failed: pose not found for step " .. tostring(seq.stepIndex)
    return false, "pose not found"
  end

  local ok, err = VanillaPoseApplier:Apply(seq.target, pose, nil, seq.instant == true, nil, true)
  if not ok then
    VPA_SEQUENCE_STATE.active = nil
    VanillaPoseApplierUI.sequenceRunning = false
    VanillaPoseApplierUI.sequenceStatus = "Sequence failed on step " .. tostring(seq.stepIndex) .. ": " .. tostring(err or "apply failed")
    return false, err
  end

  VanillaPoseApplierUI.sequenceStatus = string.format("Running step %d/%d: %s", seq.stepIndex, #seq.steps, tostring(step.name or "?"))
  return true
end

local function vpa_sequenceStartForTarget(target, steps, instant)
  if type(steps) ~= "table" or #steps <= 0 then
    return false, "no sequence steps"
  end
  if not target then
    return false, "no target"
  end

  local seq = {
    target = target,
    steps = vpa_sequenceCloneSteps(steps),
    instant = (instant == true),
    stepIndex = 0,
    stepElapsed = 0.0,
    waitForActive = false,
    waitElapsed = 0.0,
    transitionDelay = 0.0,
  }

  VPA_SEQUENCE_STATE.active = seq
  VanillaPoseApplierUI.sequenceRunning = true
  return vpa_sequenceAdvance(seq, "Sequence complete.")
end

local function vpa_sequenceStartCurrent()
  local target, err = vpa_resolveApplyTarget()
  if not target then
    return false, err or "no target"
  end
  return vpa_sequenceStartForTarget(target, VanillaPoseApplierUI.sequenceSteps, VanillaPoseApplierUI.instant == true)
end

local function vpa_sequenceUpdate(deltaTime)
  local seq = VPA_SEQUENCE_STATE.active
  if not seq then
    return
  end

  local dt = tonumber(deltaTime) or 0
  if dt <= 0 then
    return
  end

  local step = seq.steps[seq.stepIndex]
  if not step then
    VPA_SEQUENCE_STATE.active = nil
    VanillaPoseApplierUI.sequenceRunning = false
    return
  end

  if seq.transitionDelay and seq.transitionDelay > 0 then
    seq.transitionDelay = math.max(0, seq.transitionDelay - dt)
    if seq.transitionDelay > 0 then
      return
    end
    vpa_sequenceAdvance(seq, "Sequence complete.")
    return
  end

  if seq.waitForActive then
    seq.waitElapsed = (tonumber(seq.waitElapsed) or 0) + dt
    local active = VanillaPoseApplier:GetActive(seq.target)
    if active and active.pose and active.pose.name == step.name then
      seq.waitForActive = false
      seq.waitElapsed = 0.0
      seq.stepElapsed = 0.0
      VanillaPoseApplierUI.sequenceStatus = string.format("Running step %d/%d: %s", seq.stepIndex, #seq.steps, tostring(step.name or "?"))
      return
    end
    if seq.waitElapsed >= 1.5 then
      VPA_SEQUENCE_STATE.active = nil
      VanillaPoseApplierUI.sequenceRunning = false
      VanillaPoseApplierUI.sequenceStatus = "Sequence failed: timed out waiting for step " .. tostring(seq.stepIndex)
      return
    end
    return
  end

  seq.stepElapsed = (tonumber(seq.stepElapsed) or 0) + dt
  local duration = tonumber(step.seconds) or parsePositiveNumber(step.secondsText) or 0
  if duration <= 0 then
    duration = 0.01
  end

  if seq.stepElapsed < duration then
    return
  end

  local action = tostring(step.endAction or "None")
  if action == "Freeze" then
    local ok, freezeErr = VanillaPoseApplier:SetFrozen(seq.target, true, false)
    if not ok then
      VPA_SEQUENCE_STATE.active = nil
      VanillaPoseApplierUI.sequenceRunning = false
      VanillaPoseApplierUI.sequenceStatus = "Sequence freeze failed: " .. tostring(freezeErr or "unknown error")
      return
    end
  elseif action == "Stop" then
    local ok, stopErr = VanillaPoseApplier:Stop(seq.target, true)
    if not ok then
      VPA_SEQUENCE_STATE.active = nil
      VanillaPoseApplierUI.sequenceRunning = false
      VanillaPoseApplierUI.sequenceStatus = "Sequence stop failed: " .. tostring(stopErr or "unknown error")
      return
    end
  end

  local hasNext = seq.steps[seq.stepIndex + 1] ~= nil
  if not hasNext then
    VPA_SEQUENCE_STATE.active = nil
    VanillaPoseApplierUI.sequenceRunning = false
    VanillaPoseApplierUI.sequenceStatus = string.format("Sequence complete after %d step(s).", #seq.steps)
    return
  end

  seq.transitionDelay = 0.05
  VanillaPoseApplierUI.sequenceStatus = string.format("Completed step %d/%d: %s", seq.stepIndex, #seq.steps, tostring(step.name or "?"))
end

vpa_refreshVisible()


function VanillaPoseApplier.OnUpdate(deltaTime)
  vpa_updateJobs(deltaTime)
  VanillaPoseApplier:_updateTimedControls(deltaTime)
  vpa_sequenceUpdate(deltaTime)
end

function VanillaPoseApplier.OnShutdown()
  pcall(function()
    vpa_sequenceStopCurrent(true)
    VanillaPoseApplier:StopAll()
  end)
end

