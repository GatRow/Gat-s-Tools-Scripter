  else
    local rigOptions = VanillaPoseApplier:GetRigOrder()
    action.rig = tostring(action.rig or vpa_getLastRig(rigOptions[1] or "Player Man"))
    if not vpa_containsString(rigOptions, action.rig) then
      action.rig = tostring(vpa_getLastRig(rigOptions[1] or "Player Man"))
      if not vpa_containsString(rigOptions, action.rig) then
        action.rig = tostring(rigOptions[1] or "Player Man")
      end
    end
    if ImGui.BeginCombo("Rig##pose_rig_" .. idSuffix, tostring(action.rig or "")) then
      for _, rig in ipairs(rigOptions) do
        local isSelected = tostring(action.rig or "") == rig
        if ImGui.Selectable(rig .. " (" .. tostring(VanillaPoseApplier:GetPoseCount(rig)) .. ")", isSelected) then
          action.rig = rig
          vpa_setLastRig(rig)
        end
        if isSelected then ImGui.SetItemDefaultFocus() end
      end
      ImGui.EndCombo()
    end
    ImGui.SameLine()
    if ImGui.Button("Random Pose##pose_random_" .. idSuffix) then
      local randomPose = vpa_pickRandomPose(tostring(action.rig or ""))
      if randomPose then
        action.poseSearch = ""
        action.poseName = tostring(randomPose.name or "")
        action.name = tostring(randomPose.name or "")
        vpa_setLastRig(randomPose.rig)
      end
    end

    local changedSearch, newSearch = readInputText("Search Animation##pose_search_" .. idSuffix, tostring(action.poseSearch or ""), 128)
    if changedSearch then action.poseSearch = tostring(newSearch or "") end

    local searchLimit = vpa_getPoseSearchLimit(120)
    local results = VanillaPoseApplier:Search(tostring(action.poseSearch or ""), tostring(action.rig or ""), searchLimit)
    local cap = math.min(#results, searchLimit)
    ImGui.TextDisabled("Selected: " .. vpa_describePoseSelection(action.poseName or action.name or "", action.rig or ""))
    if cap > 0 and ImGui.BeginChild("##pose_action_list_" .. idSuffix, 0, 180, true) then
      for i = 1, cap do
        local pose = results[i]
        local isSelected = tostring(action.poseName or "") == tostring(pose.name or "")
        if ImGui.Selectable(tostring(pose.displayName or pose.name) .. "##pose_action_pick_" .. idSuffix .. "_" .. tostring(i), isSelected) then
          action.poseName = tostring(pose.name or "")
          action.name = tostring(pose.name or "")
          vpa_setLastRig(action.rig)
        end
      end
      ImGui.EndChild()
      if #results >= searchLimit then
        ImGui.TextDisabled("Showing first " .. tostring(searchLimit) .. " matches. Raise Pose Search Result Cap in Settings to see more.")
      end
    else
      ImGui.TextDisabled("No matching animations found.")
    end

    local changedInstant, instant = readCheckbox("Instant jump##pose_instant_" .. idSuffix, action.instant ~= false)
    if changedInstant then action.instant = instant end
    local freezeLabel = action.freezeAfterSeconds ~= nil and tostring(action.freezeAfterSeconds) or ""
    local changedFreeze, freezeText = readInputText("Freeze after seconds##pose_freeze_" .. idSuffix, freezeLabel, 16)
    if changedFreeze then action.freezeAfterSeconds = parsePositiveNumber(freezeText) or 0 end
    local stopLabel = action.stopAfterSeconds ~= nil and tostring(action.stopAfterSeconds) or ""
    local changedStop, stopText = readInputText("Stop after seconds##pose_stop_" .. idSuffix, stopLabel, 16)
    if changedStop then action.stopAfterSeconds = parsePositiveNumber(stopText) or 0 end
    local freezeAfterSeconds = tonumber(action.freezeAfterSeconds or 0) or 0
    local stopAfterSeconds = tonumber(action.stopAfterSeconds or 0) or 0
    if freezeAfterSeconds > 0 and stopAfterSeconds > 0 and stopAfterSeconds < freezeAfterSeconds then
      ImGui.TextWrapped("Warning: stop happens before freeze, so the freeze step may never fire.")
    end
  end
end

