local function vpa_detectPlayerRigKey(handle)
  if not handle then
    return nil
  end

  local probes = {
    function() return handle:GetResolvedGenderName() end,
    function() return handle:GetResolvedGender() end,
    function() return handle:GetGender() end,
  }

  for _, probe in ipairs(probes) do
    local ok, gender = pcall(probe)
    if ok and gender ~= nil then
      local genderText = tostring(gender or "")
      if genderText ~= "" then
        local lower = genderText:lower()
        if lower:find("female", 1, true) then
          return "player_woman_skeleton"
        end
        if lower:find("male", 1, true) then
          return "player_man_skeleton"
        end
      end
    end
  end

  local hasWomanComponent = false
  pcall(function()
    hasWomanComponent = handle:FindComponentByName("fx_woman_base") ~= nil
  end)
  if hasWomanComponent then
    return "player_woman_skeleton"
  end

  return "player_man_skeleton"
end

local function vpa_detectTargetRigKeys(handle, isPlayer)
  if not handle then
    return {}
  end

  if isPlayer then
    return { vpa_detectPlayerRigKey(handle) }
  end

  local compRig = nil
  pcall(function()
    if handle:FindComponentByName("fx_woman_base") then
      compRig = "woman"
      return
    end
    if handle:FindComponentByName("fx_man_base") then
      compRig = "man"
      return
    end
  end)

  if compRig == "woman" then
    return { "woman_base" }
  end

  if compRig == "man" then
    return {
      "man_base",
      "man_big",
      "man_child",
      "man_fat",
      "man_massive",
    }
  end

  return {}
end

