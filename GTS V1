function VanillaPoseApplier.GetSequenceAssets()
  local assets = (AssetRegistry and AssetRegistry.List and AssetRegistry.List("animation_sequence")) or {}
  local out = {}
  for i = 1, #assets do out[i] = assets[i] end
  table.sort(out, function(a, b)
    return tostring((a and a.name) or ""):lower() < tostring((b and b.name) or ""):lower()
  end)
  return out
end

function VanillaPoseApplier.DescribeSequenceAsset(asset)
  if type(asset) ~= "table" then return "(missing sequence)" end
  local steps = ((((asset or {}).data or {}).steps) or {})
  return string.format("%s (%d step%s)", tostring(asset.name or asset.id or "Sequence"), #steps, (#steps == 1 and "" or "s"))
end

function VanillaPoseApplier.BuildSequenceAsset(name, steps, existing)
  local asset = type(existing) == "table" and copyTable(existing) or ((AssetRegistry.MakeEmptyAnimationSequence and AssetRegistry.MakeEmptyAnimationSequence()) or { type = "animation_sequence", data = {} })
  asset.type = "animation_sequence"
  asset.name = vpa_trimString(name)
  if asset.name == "" then asset.name = "Animation Sequence" end
  asset.data = type(asset.data) == "table" and asset.data or {}
  asset.data.steps = vpa_sequenceCloneSteps(steps or {})
  return asset
end

function VanillaPoseApplier.SaveSequenceAsset(name, steps, existingId)
  local existing = existingId and AssetRegistry.Get and AssetRegistry.Get(existingId) or nil
  local asset = VanillaPoseApplier.BuildSequenceAsset(name, steps, existing)
  local saved, err
  if existingId and existing then
    saved, err = AssetRegistry.Upsert and AssetRegistry.Upsert(asset)
  else
    saved, err = ((AssetRegistry.UpsertNew and AssetRegistry.UpsertNew(asset, name)) or (AssetRegistry.Upsert and AssetRegistry.Upsert(asset)))
  end
  if not saved then return nil, err end
  vpa_presetsLoadAll()
  return saved, nil
end

function VanillaPoseApplier.LoadSequenceAssetIntoBuilder(assetId, append)
  if not assetId or not AssetRegistry.Get then return false, "missing sequence asset" end
  local asset = AssetRegistry.Get(assetId)
  if not asset or tostring(asset.type or "") ~= "animation_sequence" then
    return false, "missing sequence asset"
  end
  local preset = vpa_presetsAssetToPreset(asset)
  if not preset then return false, "invalid sequence asset" end
  if append then
    for _, step in ipairs(preset.steps or {}) do
      VanillaPoseApplierUI.sequenceSteps[#VanillaPoseApplierUI.sequenceSteps + 1] = step
    end
    VanillaPoseApplierUI.sequenceStatus = "Appended sequence: " .. tostring(preset.name)
  else
    VanillaPoseApplierUI.sequenceSteps = vpa_presetsClonePresetSteps(preset.steps or {})
    VanillaPoseApplierUI.sequenceStatus = "Loaded sequence: " .. tostring(preset.name)
  end
  VanillaPoseApplierUI.sequenceSelectedIndex = #VanillaPoseApplierUI.sequenceSteps > 0 and 1 or 0
  VanillaPoseApplierUI.presetName = tostring(preset.name or "")
  return true
end

function VanillaPoseApplier.ResolveActionTarget(targetMode)
  if tostring(targetMode or "target") == "player" then
    local player = vpa_safePlayer()
    if not player then return nil, "player unavailable" end
    return vpa_wrapTarget(player, "player"), nil
  end
  local target, err = vpa_tryGetTarget()
  if target then return target, nil end
  return nil, err or "no target"
end

