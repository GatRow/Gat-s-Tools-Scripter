function VanillaPoseApplier:_resolveTarget(target)
  if not target then
    return nil, nil, nil
  end

  local isTable = (type(target) == "table")
  local handle = isTable and target.handle or target
  if not handle then
    return nil, nil, nil
  end

  local fallbackKey = nil
  if isTable then
    fallbackKey = target.hash or target.id or target.key
  end

  local key = safeEntityKey(handle, fallbackKey)
  return handle, key, makeTargetRecord(handle, key)
end

function VanillaPoseApplier:_disposeEntry(entry, keepFreeze)
  if not entry then
    return
  end

  if entry.targetHandle then
    pcall(function()
      Game.GetWorkspotSystem():StopInDevice(entry.targetHandle)
    end)
  end

  if entry.host then
    pcall(function()
      exEntitySpawner.Despawn(entry.host)
    end)

    pcall(function()
      entry.host:Dispose()
    end)
  end

  if not keepFreeze and entry.key and self.frozenTargets[entry.key] then
    pcall(function()
      if TimeDilationHelper and TimeDilationHelper.UnsetIndividualTimeDilation and entry.targetHandle then
        TimeDilationHelper.UnsetIndividualTimeDilation(entry.targetHandle)
      end
    end)
    self.frozenTargets[entry.key] = nil
  end
end

function VanillaPoseApplier:IsFrozen(target)
  local _, key = self:_resolveTarget(target)
  if not key then
    return false
  end
  return self.frozenTargets[key] == true
end

function VanillaPoseApplier:SetFrozen(target, freeze, resumePose)
  local handle, key = self:_resolveTarget(target)
  if not handle or not key then
    return false, "invalid target"
  end

  local entry = self.active[key]

  if freeze then
    if entry then
      pcall(function()
        Game.GetWorkspotSystem():StopInDevice(handle)
      end)
    end

    local ok = pcall(function()
      if TimeDilationHelper and TimeDilationHelper.SetIndividualTimeDilation then
        TimeDilationHelper.SetIndividualTimeDilation(handle, CName.new("radialMenu"), 0.0)
      else
        error("TimeDilationHelper unavailable")
      end
    end)

    if not ok then
      return false, "freeze unavailable"
    end

    self.frozenTargets[key] = true
    if entry then
      entry.isFrozen = true
    end
    self:_setRuntimeMessage("Frozen target")
    return true
  end

  local ok = pcall(function()
    if TimeDilationHelper and TimeDilationHelper.UnsetIndividualTimeDilation then
      TimeDilationHelper.UnsetIndividualTimeDilation(handle)
    else
      error("TimeDilationHelper unavailable")
    end
  end)

  if not ok then
    return false, "unfreeze unavailable"
  end

  self.frozenTargets[key] = nil
  if entry then
    entry.isFrozen = nil
  end

  if resumePose ~= false and entry and entry.host and entry.pose then
    pcall(function()
      Game.GetWorkspotSystem():PlayInDeviceSimple(entry.host, handle, false, entry.pose.comp, nil, nil, 0, 1, nil)
      Game.GetWorkspotSystem():SendJumpToAnimEnt(handle, entry.pose.name, true)
    end)
  end

  self:_setRuntimeMessage("Unfrozen target")
  return true
end


function VanillaPoseApplier:_startController(key, targetRecord, pose, controls, instant)
  if not key then
    return
  end

  self:_clearController(key)

  if not controls then
    return
  end

  local entry = self.active[key]
  if not entry then
    return
  end

  local stopAfterSeconds = tonumber(controls.stopAfterSeconds)
  local freezeAfterSeconds = tonumber(controls.freezeAfterSeconds)

  if not ((freezeAfterSeconds and freezeAfterSeconds > 0) or (stopAfterSeconds and stopAfterSeconds > 0)) then
    return
  end

  entry.timedControls = {
    elapsed = 0.0,
    freezeAfterSeconds = (freezeAfterSeconds and freezeAfterSeconds > 0) and freezeAfterSeconds or nil,
    stopAfterSeconds = (stopAfterSeconds and stopAfterSeconds > 0) and stopAfterSeconds or nil,
    freezeTriggered = false,
    stopTriggered = false,
  }
end

function VanillaPoseApplier:_updateTimedControls(deltaTime)
  local dt = tonumber(deltaTime) or 0
  if dt <= 0 then
    return
  end

  local pending = {}

  for key, entry in pairs(self.active) do
    local timed = entry and entry.timedControls
    if timed then
      timed.elapsed = (tonumber(timed.elapsed) or 0) + dt

      local stopAfterSeconds = tonumber(timed.stopAfterSeconds)
      local freezeAfterSeconds = tonumber(timed.freezeAfterSeconds)

      if stopAfterSeconds and stopAfterSeconds > 0 and not timed.stopTriggered and timed.elapsed >= stopAfterSeconds then
        timed.stopTriggered = true
        pending[#pending + 1] = { action = "stop", key = key, seconds = stopAfterSeconds, handle = entry.targetHandle }
      elseif freezeAfterSeconds and freezeAfterSeconds > 0 and not timed.freezeTriggered and timed.elapsed >= freezeAfterSeconds then
        timed.freezeTriggered = true
        pending[#pending + 1] = { action = "freeze", key = key, seconds = freezeAfterSeconds, handle = entry.targetHandle }
      end
    end
  end

  for i = 1, #pending do
    local item = pending[i]
    local activeEntry = self.active[item.key]
    if activeEntry and activeEntry.targetHandle then
      if item.action == "freeze" then
        local ok, err = self:SetFrozen(activeEntry.targetHandle, true, false)
        if ok then
          self:_setRuntimeMessage("Froze target after " .. formatSeconds(item.seconds))
        else
          self:_setRuntimeMessage("Freeze timer failed: " .. tostring(err or "unknown error"))
        end
        if self.active[item.key] then
          self.active[item.key].timedControls = nil
        end
      elseif item.action == "stop" then
        local ok, err = self:Stop(activeEntry.targetHandle, true)
        if ok then
          self:_setRuntimeMessage("Stopped pose after " .. formatSeconds(item.seconds))
        else
          self:_setRuntimeMessage("Stop timer failed: " .. tostring(err or "unknown error"))
        end
        self.controllers[item.key] = nil
      end
    end
  end
end

function VanillaPoseApplier:Stop(target, preserveController)
  local handle, key = self:_resolveTarget(target)
  if not handle or not key then
    return false, "invalid target"
  end

  if not preserveController then
    self:_clearController(key)
  end

  local entry = self.active[key]
  if not entry then
    pcall(function()
      Game.GetWorkspotSystem():StopInDevice(handle)
    end)
    if self.frozenTargets[key] then
      pcall(function()
        if TimeDilationHelper and TimeDilationHelper.UnsetIndividualTimeDilation then
          TimeDilationHelper.UnsetIndividualTimeDilation(handle)
        end
      end)
      self.frozenTargets[key] = nil
    end
    return true
  end

  self:_disposeEntry(entry)
  self.active[key] = nil
  return true
end

function VanillaPoseApplier:StopAll()
  for key, _ in pairs(self.controllers) do
    self:_clearController(key)
  end
  for key, entry in pairs(self.active) do
    self:_disposeEntry(entry)
    self.active[key] = nil
  end
  for key, _ in pairs(self.frozenTargets) do
    self.frozenTargets[key] = nil
  end
end

function VanillaPoseApplier:GetActive(target)
  local _, key = self:_resolveTarget(target)
  if not key then
    return nil
  end

  return self.active[key]
end


function VanillaPoseApplier:_playAttempt(host, handle, comp, poseName, instant, channel)
  local okPlay, playErr = pcall(function()
    Game.GetWorkspotSystem():PlayInDeviceSimple(
      host,
      handle,
      false,
      comp,
      channel,
      nil,
      0,
      1,
      nil
    )
  end)

  if not okPlay then
    return false, "Play failed: " .. tostring(playErr)
  end

  local okJump, jumpErr = pcall(function()
    Game.GetWorkspotSystem():SendJumpToAnimEnt(handle, poseName, instant == true)
  end)

  if not okJump then
    return false, "Jump failed: " .. tostring(jumpErr)
  end

  return true, nil
end

function VanillaPoseApplier:_cleanupHost(host, handle)
  if handle then
    pcall(function()
      Game.GetWorkspotSystem():StopInDevice(handle)
    end)
  end

  if host then
    pcall(function()
      exEntitySpawner.Despawn(host)
    end)
    pcall(function()
      host:Dispose()
    end)
  end
end

function VanillaPoseApplier:Apply(target, poseOrRig, exactName, instant, controls, preserveController)
  self:_ensureRuntimeNames()
  local pose = poseOrRig
  if type(poseOrRig) ~= "table" then
    pose = self:FindPose(poseOrRig, exactName)
  end

  if not pose then
    return false, "pose not found"
  end

  if not exEntitySpawner or not exEntitySpawner.Spawn then
    local msg = "Entity spawner unavailable"
    self:_setRuntimeMessage(msg)
    logRuntime(msg)
    return false, msg
  end

  local workspotSystem = nil
  local okWorkspot = pcall(function()
    workspotSystem = Game.GetWorkspotSystem()
  end)
  if not okWorkspot or not workspotSystem then
    local msg = "Workspot system unavailable"
    self:_setRuntimeMessage(msg)
    logRuntime(msg)
    return false, msg
  end

  local handle, key, targetRecord = self:_resolveTarget(target)
  if not handle or not key or not targetRecord then
    return false, "invalid target"
  end

  local allowedLabels = targetRecord.allowedRigLabels or {}
  if #allowedLabels > 0 and not vpa_containsString(allowedLabels, pose.rig) then
    local msg = "Target is not compatible with pose rig: " .. tostring(pose.rig)
    self:_setRuntimeMessage(msg)
    logRuntime(msg)
    return false, msg
  end

  if not preserveController then
    self:_clearController(key)
  end

  self:Stop(targetRecord, preserveController == true)

  local requestedPose = {
    id = pose.id,
    rig = pose.rig,
    name = pose.name,
    displayName = pose.displayName or prettifyName(pose.name),
    ent = pose.ent or self.hostEntity,
    comp = pose.comp or self.hostComponent
  }

  local spawnTransform = handle:GetWorldTransform()
  spawnTransform:SetPosition(handle:GetWorldPosition())

  local facing = handle:GetWorldOrientation():ToEulerAngles()
  facing.yaw = facing.yaw + 180
  spawnTransform:SetOrientationEuler(EulerAngles.new(0, 0, facing.yaw))

  local spawnId = exEntitySpawner.Spawn(requestedPose.ent, spawnTransform, "")
  if not spawnId then
    local msg = "Host spawn failed for " .. tostring(requestedPose.ent)
    self:_setRuntimeMessage(msg)
    logRuntime(msg)
    return false, "host spawn failed"
  end

  local owner = self
  owner:_setRuntimeMessage("Waiting for host entity: " .. tostring(requestedPose.name))
  logRuntime("Spawn requested for " .. tostring(requestedPose.ent) .. " / " .. tostring(requestedPose.name))

  local elapsed = 0.0
  vpa_addJob({
    update = function(dt)
      elapsed = elapsed + (tonumber(dt) or 0)

      local host = Game.FindEntityByID(spawnId)
      if not host then
        if elapsed >= 1.25 then
          local msg = "Timed out waiting for host entity. Required pose host asset may be missing."
          owner:_setRuntimeMessage(msg)
          logRuntime(msg)
          return false
        end
        return true
      end

      local okPlay, playErr = pcall(function()
        Game.GetWorkspotSystem():PlayInDeviceSimple(host, handle, false, requestedPose.comp, owner.hostChannel, nil, 0, 1, nil)
        Game.GetWorkspotSystem():SendJumpToAnimEnt(handle, requestedPose.name, instant == true)
      end)

      if not okPlay then
        local msg = "Pose start failed: " .. tostring(playErr)
        owner:_setRuntimeMessage(msg)
        logRuntime(msg)
        owner:_cleanupHost(host, handle)
        return false
      end

      owner.active[key] = {
        host = host,
        target = targetRecord,
        targetHandle = handle,
        key = key,
        pose = requestedPose
      }

      if controls and not preserveController then
        owner:_startController(key, targetRecord, requestedPose, controls, instant)
      end

      local msg = "Pose sent: " .. tostring(requestedPose.name)
      owner:_setRuntimeMessage(msg)
      logRuntime(msg)
      return false
    end
  })

  return true
end

function VanillaPoseApplier:Restart(target, instant, preserveController)
  local active = self:GetActive(target)
  if not active or not active.pose then
    return false, "no active pose"
  end

  local pose = active.pose
  local restartTarget = active.target or target
  local ok, err = self:Stop(restartTarget, preserveController == true)
  if not ok then
    return false, err
  end

  local wait = 0.0
  vpa_addJob({
    update = function(dt)
      wait = wait + (tonumber(dt) or 0)
      if wait < 0.3 then
        return true
      end
      self:Apply(restartTarget, pose, nil, instant == true, nil, preserveController == true)
      return false
    end
  })

  return true
end


