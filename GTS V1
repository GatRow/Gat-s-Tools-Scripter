local VPA_JOBS = {}
local VPA_NEXT_JOB_ID = 1

local function vpa_addJob(job)
  job.id = VPA_NEXT_JOB_ID
  VPA_NEXT_JOB_ID = VPA_NEXT_JOB_ID + 1
  VPA_JOBS[#VPA_JOBS + 1] = job
  return job.id
end

local function vpa_removeJobById(jobId)
  for i = #VPA_JOBS, 1, -1 do
    if VPA_JOBS[i].id == jobId then
      table.remove(VPA_JOBS, i)
      return true
    end
  end
  return false
end

local function vpa_updateJobs(deltaTime)
  local dt = tonumber(deltaTime) or 0
  for i = #VPA_JOBS, 1, -1 do
    local job = VPA_JOBS[i]
    local keep = false
    local ok, result = pcall(function()
      return job:update(dt)
    end)
    if ok and result == true then
      keep = true
    end
    if not keep then
      table.remove(VPA_JOBS, i)
    end
  end
end

