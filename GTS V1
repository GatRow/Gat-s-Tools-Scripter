function VanillaPoseApplier.ExecuteSequenceAsset(assetOrId, targetMode, instant)
  local asset = assetOrId
  if type(assetOrId) ~= "table" then
    asset = AssetRegistry.Get and AssetRegistry.Get(assetOrId) or nil
  end
  if type(asset) ~= "table" then
    return false, "missing animation sequence"
  end
  if tostring(asset.type or "") ~= "animation_sequence" and type(asset.asset) == "table" and tostring((asset.asset or {}).type or "") == "animation_sequence" then
    asset = asset.asset
  end
  if not asset or tostring(asset.type or "") ~= "animation_sequence" then
    return false, "missing animation sequence"
  end
  local target, err = VanillaPoseApplier.ResolveActionTarget(targetMode)
  if not target then return false, err or "no target" end
  local steps = ((((asset or {}).data or {}).steps) or {})
  return vpa_sequenceStartForTarget(target, steps, instant == true)
end

function VanillaPoseApplier.ExecuteSequenceAssetOnHandle(assetOrId, handle, instant)
  local asset = assetOrId
  if type(assetOrId) ~= "table" then
    asset = AssetRegistry.Get and AssetRegistry.Get(assetOrId) or nil
  end
  if type(asset) ~= "table" then
    return false, "missing animation sequence"
  end
  if tostring(asset.type or "") ~= "animation_sequence" and type(asset.asset) == "table" and tostring((asset.asset or {}).type or "") == "animation_sequence" then
    asset = asset.asset
  end
  if not asset or tostring(asset.type or "") ~= "animation_sequence" then
    return false, "missing animation sequence"
  end
  if not handle then return false, "missing handle" end
  local target = vpa_wrapTarget(handle, vpa_detectHandleKind(handle))
  if not target then return false, "invalid target" end
  local steps = ((((asset or {}).data or {}).steps) or {})
  return vpa_sequenceStartForTarget(target, steps, instant == true)
end


vpa_detectHandleKind = function(handle)
  if not handle then
    return "npc"
  end

  local player = vpa_safePlayer()
  if not player then
    logRuntime("Player handle unavailable while classifying pose target; defaulting to npc.")
    return "npc"
  end

  local handleKey = safeEntityKey(handle)
  local playerKey = safeEntityKey(player)
  if not handleKey or not playerKey then
    logRuntime("Could not resolve entity keys while classifying pose target; defaulting to npc.")
    return "npc"
  end

  return handleKey == playerKey and "player" or "npc"
end

vpa_resolveActionPose = function(action)
  action = action or {}
  local rig = tostring(action.rig or "")
  local poseName = vpa_trimString(action.poseName or action.name or "")
  local pose = nil
  if rig ~= "" and poseName ~= "" then
    pose = VanillaPoseApplier:FindPose(rig, poseName)
  end
  if not pose and poseName ~= "" then
    local hits = VanillaPoseApplier:Search(poseName, rig ~= "" and rig or nil, 1)
    pose = hits[1]
  end
  return pose
end

vpa_parseControls = function(action)
  action = action or {}
  local controls = {
    freezeAfterSeconds = tonumber(action.freezeAfterSeconds or 0) or nil,
    stopAfterSeconds = tonumber(action.stopAfterSeconds or 0) or nil,
  }
  if controls.freezeAfterSeconds and controls.freezeAfterSeconds <= 0 then controls.freezeAfterSeconds = nil end
  if controls.stopAfterSeconds and controls.stopAfterSeconds <= 0 then controls.stopAfterSeconds = nil end
  if controls.freezeAfterSeconds and controls.stopAfterSeconds and controls.stopAfterSeconds < controls.freezeAfterSeconds then
    logRuntime(string.format(
      "Pose action warning: stopAfterSeconds (%.3f) occurs before freezeAfterSeconds (%.3f). Freeze may never trigger.",
      controls.stopAfterSeconds,
      controls.freezeAfterSeconds
    ))
  end
  return controls
end

function VanillaPoseApplier.ExecuteActionOnHandle(action, handle)
  action = action or {}
  if not handle then return false, "missing handle" end
  local sourceMode = tostring(action.sourceMode or "pose_db")
  local instant = action.instant ~= false
  if sourceMode == "saved_sequence" then
    local seqAsset = action.sequenceAsset or action.embeddedSequence or nil
    if not seqAsset and action.sequenceRef then
      seqAsset = action.sequenceRef
    end
    return VanillaPoseApplier.ExecuteSequenceAssetOnHandle(seqAsset, handle, instant)
  end

  local target = vpa_wrapTarget(handle, vpa_detectHandleKind(handle))
  if not target then return false, "invalid target" end

  local pose = vpa_resolveActionPose(action)
  if not pose then return false, "pose not found" end

  return VanillaPoseApplier:Apply(target, pose, nil, instant, vpa_parseControls(action))
end

function VanillaPoseApplier.ExecuteAction(action, targetMode)
  action = action or {}
  local sourceMode = tostring(action.sourceMode or "pose_db")
  local instant = action.instant ~= false
  if sourceMode == "saved_sequence" then
    local seqAsset = action.sequenceAsset or action.embeddedSequence or nil
    if not seqAsset and action.sequenceRef then
      seqAsset = action.sequenceRef
    end
    return VanillaPoseApplier.ExecuteSequenceAsset(seqAsset, targetMode, instant)
  end

  local target, err = VanillaPoseApplier.ResolveActionTarget(targetMode)
  if not target then return false, err or "no target" end

  local pose = vpa_resolveActionPose(action)
  if not pose then return false, "pose not found" end

  return VanillaPoseApplier:Apply(target, pose, nil, instant, vpa_parseControls(action))
end

function VanillaPoseApplier.DescribeActionTarget(action)
  action = action or {}
  if tostring(action.sourceMode or "pose_db") == "saved_sequence" then
    local asset = (action.sequenceRef and AssetRegistry.Get and AssetRegistry.Get(action.sequenceRef)) or action.sequenceAsset or action.embeddedSequence or nil
    return asset and VanillaPoseApplier.DescribeSequenceAsset(asset) or "(choose saved animation sequence)"
  end
  local poseName = vpa_trimString(action.poseName or action.name or "")
  if poseName == "" then poseName = "(choose animation)" end
  local rig = vpa_trimString(action.rig or "")
  local parts = {poseName}
  if rig ~= "" then parts[#parts + 1] = rig end
  local freezeAfterSeconds = tonumber(action.freezeAfterSeconds or 0) or 0
  local stopAfterSeconds = tonumber(action.stopAfterSeconds or 0) or 0
  if freezeAfterSeconds > 0 then parts[#parts + 1] = string.format("freeze %.2fs", freezeAfterSeconds) end
  if stopAfterSeconds > 0 then parts[#parts + 1] = string.format("stop %.2fs", stopAfterSeconds) end
  return table.concat(parts, " | ")
end

function VanillaPoseApplier.DrawActionSetup(action, targetMode, idSuffix)
  action = action or {}
  idSuffix = tostring(idSuffix or tostring(targetMode or "pose"))
