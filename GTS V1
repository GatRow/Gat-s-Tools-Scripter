local function copyArray(source)
  local out = {}
  if type(source) ~= "table" then
    return out
  end
  for i = 1, #source do
    out[i] = source[i]
  end
  return out
end

local function copyTable(source, seen)
  if type(source) ~= "table" then return source end
  seen = seen or {}
  if seen[source] then return seen[source] end
  local out = {}
  seen[source] = out
  for k, v in pairs(source) do
    out[copyTable(k, seen)] = copyTable(v, seen)
  end
  return out
end

local function prettifyName(name)
  local text = tostring(name or "")
  text = text:gsub("__", " ")
  text = text:gsub("_", " ")
  text = text:gsub("%s+", " ")
  text = text:gsub("^%s+", "")
  text = text:gsub("%s+$", "")
  return text
end

local function normalizeQuery(text)
  local q = tostring(text or ""):lower()
  q = q:gsub("%s+", " ")
  q = q:gsub("^%s+", "")
  q = q:gsub("%s+$", "")
  return q
end

local function vpa_trimString(value)
  local s = tostring(value or "")
  s = s:gsub("^%s+", "")
  s = s:gsub("%s+$", "")
  return s
end

local function vpa_getPoseSearchLimit(defaultValue)
  local fallback = tonumber(defaultValue or 240) or 240
  local settingsValue = type(UISettings) == "table" and tonumber(UISettings.poseSearchLimit or fallback) or fallback
  settingsValue = math.floor(settingsValue or fallback)
  if settingsValue < 50 then settingsValue = 50 end
  return settingsValue
end

local function vpa_setLastRig(rig)
  rig = vpa_trimString(rig or "")
  if rig == "" or type(UISettings) ~= "table" then
    return
  end
  if tostring(UISettings.lastPoseRig or "") == rig then
    return
  end
  UISettings.lastPoseRig = rig
  if type(UISettings.Save) == "function" then
    pcall(UISettings.Save, UISettings, UISettings)
  end
end

local function vpa_getLastRig(defaultRig)
  local rig = type(UISettings) == "table" and vpa_trimString(UISettings.lastPoseRig or "") or ""
  if rig ~= "" then return rig end
  return tostring(defaultRig or "Player Man")
end

local function safeEntityKey(handle, fallback)
  if fallback ~= nil then
    return tostring(fallback)
  end

  local ok, entityId = pcall(function()
    return handle:GetEntityID()
  end)

  if ok and entityId ~= nil then
    if entityId.hash ~= nil then
      return tostring(entityId.hash)
    end

    return tostring(entityId)
  end

  return tostring(handle)
end

local function makeTargetRecord(handle, fallbackKey)
  if not handle then
    return nil
  end

  local key = safeEntityKey(handle, fallbackKey)
  return {
    handle = handle,
    hash = key,
    key = key
  }
end

