      for i = 1, #labels do
        local item = labels[i]
        local selected = (item == current)
        if ImGui.Selectable(item, selected) then current = item end
      end
      ImGui.EndCombo()
    end
    return current
  end

  local currentIndex = 0
  for i = 1, #labels do if labels[i] == current then currentIndex = i - 1 break end end
