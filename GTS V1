  if txt == "" then return false, "Enter custom text first" end
  local msgMode = tostring(mode or "screen")
  local secs = tonumber(duration or 8) or 8
  if secs < 1 then secs = 1 end
  if secs > 30 then secs = 30 end
  local p = _getPlayer()
  local ok, err = pcall(function()
    if msgMode == "screen" then
      -- SimpleScreenMessage.message is a CName in CP2077 2.x — must use CName.new()
      local MSG = SimpleScreenMessage.new()
      MSG.isShown = true
      MSG.duration = secs
      -- Try CName.new first; fall back to raw string if CName unavailable
      MSG.message = (CName and CName.new and CName.new(txt)) or txt
      local bb = Game.GetBlackboardSystem():Get(GetAllBlackboardDefs().UI_Notifications)
      bb:SetVariant(GetAllBlackboardDefs().UI_Notifications.OnscreenMessage, ToVariant(MSG), true)
    elseif msgMode == "subtitle" or msgMode == "alert" then
      -- Use the subtitle/alert notification channel
      if p and p.SetWarningMessage then
        p:SetWarningMessage(txt, gameSimpleMessageType.Neutral)
      else
        error("Player warning API unavailable")
      end
    elseif msgMode == "shard" then
      local ev = NotifyShardRead.new()
      ev.title = (CName and CName.new and CName.new("Message")) or "Message"
      ev.text  = (CName and CName.new and CName.new(txt)) or txt
      Game.GetUISystem():QueueEvent(ev)
    elseif msgMode == "neutral" then
      if not p or not p.SetWarningMessage then error("Player warning API unavailable") end
      p:SetWarningMessage(txt, gameSimpleMessageType.Neutral)
    elseif msgMode == "relic" then
      if not p or not p.SetWarningMessage then error("Player warning API unavailable") end
      p:SetWarningMessage(txt, gameSimpleMessageType.Relic)
    elseif msgMode == "money" then
      if not p or not p.SetWarningMessage then error("Player warning API unavailable") end
      -- Money uses a string key, not enum
      pcall(function() p:SetWarningMessage(txt, "Money") end)
      -- Fallback: neutral
      pcall(function() p:SetWarningMessage(txt, gameSimpleMessageType.Neutral) end)
    else
      -- Fallback: try neutral warning
      if p and p.SetWarningMessage then
        p:SetWarningMessage(txt, gameSimpleMessageType.Neutral)
      else
        error("UI message API unavailable")
      end
    end
  end)
  if not ok then return false, tostring(err) end
  return true, "Displayed message"
end


