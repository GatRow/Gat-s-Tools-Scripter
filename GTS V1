local function _drawWhenSection(draft)
  local conditions = draft.data.conditions or {}
  draft.data.conditions = conditions

  _textColored(0.92, 0.82, 0.28, 1.0, "Conditions")
  ImGui.SameLine()
  ImGui.TextDisabled("Checks that must pass before the script fires. Leave empty to fire manually.")
  draft.data.conditionMode = _comboSelect("Match##macro_when_mode", draft.data.conditionMode or "ALL", { "ALL", "ANY" }, 80)
  ImGui.SameLine()
  ImGui.TextDisabled("ALL = every condition must pass  |  ANY = at least one must pass")

  -- Two-step grouped picker: choose from categorised dropdown, then click Add.
  -- This avoids accidental bulk-adds from re-renders.
  local options = _conditionOptions()
  local categoryOrder = {
    "Movement", "Combat", "Equipment", "Inventory",
    "Vehicle", "Target", "Quest", "Gameplay", "Custom Conditions", "Manual Test"
  }
  -- Build flat label/option lists with group headers (headers have opt=nil)
  local comboLabels  = { "(select condition to add...)" }
  local comboOptions = { nil }
  for _, cat in ipairs(categoryOrder) do
    local headerAdded = false
    for _, opt in ipairs(options) do
      if tostring(opt.category or "") == cat then
        if not headerAdded then
          comboLabels[#comboLabels + 1]  = "── " .. cat .. " ──"
          comboOptions[#comboOptions + 1] = nil
          headerAdded = true
        end
        comboLabels[#comboLabels + 1]  = "  " .. tostring(opt.label or "")
        comboOptions[#comboOptions + 1] = opt
      end
    end
  end

  local st = RuleBuilder.state
  st._condPickerIdx = math.max(1, math.min(st._condPickerIdx or 1, #comboLabels))

  -- Show the currently selected item (strip indent for display)
  local displayLabel = (comboLabels[st._condPickerIdx] or comboLabels[1]):match("^%s*(.-)%s*$")
  if displayLabel:sub(1,2) == "──" then displayLabel = comboLabels[1] end

  if ImGui.BeginCombo("##cond_picker_combo", displayLabel) then
    for li = 1, #comboLabels do
      local opt = comboOptions[li]
      if opt == nil then
        ImGui.TextDisabled(comboLabels[li])       -- non-selectable header
      else
        local selected = (li == st._condPickerIdx)
        if ImGui.Selectable(comboLabels[li], selected) then
          st._condPickerIdx = li
        end
        if selected then ImGui.SetItemDefaultFocus() end
      end
    end
    ImGui.EndCombo()
  end
  ImGui.SameLine()
  if ImGui.Button("Add##cond_add_btn") then
    local opt = comboOptions[st._condPickerIdx]
    if opt then
      local new = _clone(opt)
      new.expected = true
      conditions[#conditions + 1] = new
      _markDraftDirty()
    end
  end
  ImGui.SameLine()
  ImGui.TextDisabled(tostring(#conditions) .. " condition(s)")

  if #conditions == 0 then
    ImGui.TextDisabled("No conditions yet — script fires whenever its Timing triggers.")
    return
  end

  -- Wrap table in a scrollable child so it never overflows the column
  local tableH = math.min(#conditions * 26 + 34, 280)
  if ImGui.BeginChild("cond_table_scroll", 0, tableH, false) then
    _drawConditionRowsTable(conditions, "rule_root")
    ImGui.EndChild()
  end
end

local function _selectedActionContext(draft)
  local st = RuleBuilder.state
  draft.data.actions = draft.data.actions or {}
  draft.data.falseActions = draft.data.falseActions or {}

  local wantFalse = (st.selectedActionList == "false")
  local groupKey = wantFalse and "falseActionGroups" or "actionGroups"
  local selectedGroupKey = wantFalse and "selectedFalseActionGroupIndex" or "selectedActionGroupIndex"
  local selectedKey = wantFalse and "selectedFalseActionIndex" or "selectedActionIndex"
  local label = wantFalse and "ON FALSE" or "DO"
  local groups = _ensureActionGroupsForDraft(draft, groupKey)

  if #groups == 0 and wantFalse then
    groupKey = "actionGroups"
    selectedGroupKey = "selectedActionGroupIndex"
    selectedKey = "selectedActionIndex"
    label = "DO"
    st.selectedActionList = "do"
    groups = _ensureActionGroupsForDraft(draft, groupKey)
  end

  if #groups == 0 then return nil end

  local gidx = math.max(1, math.min(tonumber(st[selectedGroupKey] or 1) or 1, #groups))
  st[selectedGroupKey] = gidx
  local group = groups[gidx]
  group.actions = group.actions or {}
  local actions = group.actions

  local idx = 0
  local action = nil
  if #actions > 0 then
    idx = math.max(1, math.min(tonumber(st[selectedKey] or 1) or 1, #actions))
    st[selectedKey] = idx
    action = _ensureActionDefaults(actions[idx])
    actions[idx] = action
  else
    st[selectedKey] = 1
  end

  return {
    groupKey = groupKey,
    selectedGroupKey = selectedGroupKey,
    selectedKey = selectedKey,
    label = label,
    groups = groups,
    groupIndex = gidx,
    group = group,
    groupName = tostring(group.name or (wantFalse and "Exit Group" or "Group")),
    actions = actions,
    index = idx,
    action = action,
  }
end

